#!/usr/bin/env bash
set -uo pipefail

if (( $# != 1 )); then
  echo 'usage: scripts/run-workload <workload>' >&2
  exit 2
fi

readonly workload=$1
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly root

if [[ ! -x "$root/workloads/$workload" ]] || ! jq -e --arg workload "$workload" '.workloads[$workload]' "$root/benchmarks/lock.json" >/dev/null; then
  echo "unknown workload: $workload" >&2
  exit 2
fi

harness_sha=${GITHUB_SHA:-}
if [[ ! "$harness_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo 'GITHUB_SHA must be the exact harness commit' >&2
  exit 1
fi
readonly harness_sha

readonly result="$root/benchmark-result.json"
rm -f -- "$result"

runner_temp=${RUNNER_TEMP:-${TMPDIR:-/tmp}}
work="$(mktemp -d "$runner_temp/buildkite-gha-benchmark.XXXXXXXX")"
readonly work source="$work/$workload"
trap 'rm -rf -- "$work"' EXIT

now_ns() {
  date +%s%N
}

started_ns="$(now_ns)"
readonly started_ns
fetch_started_ns="$(now_ns)"
status=0
"$root/scripts/fetch-source" "$workload" "$source" || status=$?
fetch_finished_ns="$(now_ns)"

workload_duration_json=null
if (( status == 0 )); then
  workload_started_ns="$(now_ns)"
  "$root/workloads/$workload" "$source" || status=$?
  workload_finished_ns="$(now_ns)"
  workload_duration_json=$(( (workload_finished_ns - workload_started_ns) / 1000000 ))
fi

finished_ns="$(now_ns)"
readonly fetch_started_ns fetch_finished_ns finished_ns status workload_duration_json

repository="$(jq -r --arg workload "$workload" '.workloads[$workload].repository' "$root/benchmarks/lock.json")"
upstream_sha="$(jq -r --arg workload "$workload" '.workloads[$workload].commit' "$root/benchmarks/lock.json")"
cpu_count="$(getconf _NPROCESSORS_ONLN)"
memory_bytes="$(( $(awk '/^MemTotal:/ {print $2}' /proc/meminfo) * 1024 ))"
architecture="$(uname -m)"
kernel="$(uname -r)"
os_id=unknown
os_version=unknown
if [[ -r /etc/os-release ]]; then
  # The OS-owned file provides simple ID and VERSION_ID values on supported
  # Linux runners. Do not include any other host metadata in the result.
  # shellcheck disable=SC1091
  source /etc/os-release
  os_id=${ID:-unknown}
  os_version=${VERSION_ID:-unknown}
fi

tools_json='{}'
case "$workload" in
  kafka)
    java_version="$(java -version 2>&1 | head -n 1 | tr -d '\r')"
    gradle_version=""
    if (( status == 0 )); then
      gradle_version="$("$source/gradlew" --version 2>/dev/null | awk '/^Gradle / {print $2; exit}')" || gradle_version=""
    fi
    tools_json="$(jq -cn --arg java "$java_version" --arg gradle "$gradle_version" '{java: $java, gradle: (if $gradle == "" then null else $gradle end)}')"
    ;;
  grpc)
    bazel_version="$(bazel --version 2>/dev/null | head -n 1 | tr -d '\r')"
    tools_json="$(jq -cn --arg bazel "$bazel_version" '{bazel: $bazel}')"
    ;;
esac

readonly repository upstream_sha cpu_count memory_bytes architecture kernel
readonly os_id os_version tools_json

success=false
(( status == 0 )) && success=true

set -e
tmp_result="$result.tmp"
jq -n \
  --arg schema 'buildkite-gha-benchmarks/result/v1' \
  --arg workload "$workload" \
  --arg harness_sha "$harness_sha" \
  --arg repository "$repository" \
  --arg upstream_sha "$upstream_sha" \
  --arg architecture "$architecture" \
  --arg kernel "$kernel" \
  --arg os_id "$os_id" \
  --arg os_version "$os_version" \
  --argjson tools "$tools_json" \
  --argjson success "$success" \
  --argjson exit_code "$status" \
  --argjson cpu_count "$cpu_count" \
  --argjson memory_bytes "$memory_bytes" \
  --argjson started_at_epoch_ms "$(( started_ns / 1000000 ))" \
  --argjson finished_at_epoch_ms "$(( finished_ns / 1000000 ))" \
  --argjson fetch_duration_ms "$(( (fetch_finished_ns - fetch_started_ns) / 1000000 ))" \
  --argjson workload_duration_ms "$workload_duration_json" \
  --argjson script_duration_ms "$(( (finished_ns - started_ns) / 1000000 ))" '
  {
    schema: $schema,
    workload: $workload,
    mode: "cached",
    provider: "buildkite",
    harness_sha: $harness_sha,
    upstream: {
      repository: $repository,
      commit: $upstream_sha
    },
    success: $success,
    exit_code: $exit_code,
    timing: {
      started_at_epoch_ms: $started_at_epoch_ms,
      finished_at_epoch_ms: $finished_at_epoch_ms,
      fetch_duration_ms: $fetch_duration_ms,
      workload_duration_ms: $workload_duration_ms,
      script_duration_ms: $script_duration_ms
    },
    machine: {
      architecture: $architecture,
      cpu_count: $cpu_count,
      memory_bytes: $memory_bytes,
      kernel: $kernel,
      os: {id: $os_id, version: $os_version}
    },
    tools: $tools
  }' > "$tmp_result"
mv -- "$tmp_result" "$result"

printf 'BENCHMARK_RESULT='
jq -c . "$result"
exit "$status"

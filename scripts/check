#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly root
cd "$root"

jq -e '
  .schema == "buildkite-gha-benchmarks/lock/v1" and
  (.workloads | keys == ["kafka"]) and
  (.workloads.kafka.repository == "https://github.com/apache/kafka.git") and
  (.workloads.kafka.commit | test("^[0-9a-f]{40}$"))
' benchmarks/lock.json >/dev/null

shellcheck scripts/check scripts/fetch-source scripts/run-kafka workloads/kafka

if command -v actionlint >/dev/null; then
  actionlint
fi

grep -Fq 'workflow_call:' .github/workflows/kafka.yml || {
  echo 'Kafka workflow is not reusable' >&2
  exit 1
}

grep -Fq 'workflow_dispatch:' .github/workflows/kafka.yml || {
  echo 'Kafka workflow is not directly runnable for API builds' >&2
  exit 1
}

grep -Fq 'if: build.env("BENCHMARK") == "kafka"' .buildkite/pipeline.yml || {
  echo 'Buildkite Kafka workload is not manually gated' >&2
  exit 1
}

for script in scripts/check scripts/fetch-source scripts/run-kafka workloads/kafka; do
  test -x "$script" || {
    echo "script is not executable: $script" >&2
    exit 1
  }
done

echo 'Static benchmark checks passed.'

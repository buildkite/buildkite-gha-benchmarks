#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly root
cd "$root"

jq -e '
  .schema == "buildkite-gha-benchmarks/lock/v1" and
  (.workloads | keys == ["grpc", "kafka", "mastodon", "posthog"]) and
  (.workloads.grpc.repository == "https://github.com/grpc/grpc.git") and
  (.workloads.kafka.repository == "https://github.com/apache/kafka.git") and
  (.workloads.mastodon.repository == "https://github.com/mastodon/mastodon.git") and
  (.workloads.posthog.repository == "https://github.com/PostHog/posthog.git") and
  (.workloads | to_entries | all(
    .value.repository | test("^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$")
  )) and
  (.workloads | to_entries | all(.value.commit | test("^[0-9a-f]{40}$")))
' benchmarks/lock.json >/dev/null

shellcheck scripts/check scripts/fetch-source scripts/run-kafka workloads/*

if command -v actionlint >/dev/null; then
  actionlint
fi

grep -Fq 'workflow_call:' .github/workflows/kafka.yml || {
  echo 'Kafka workflow is not reusable' >&2
  exit 1
}

grep -Fq 'workflow_dispatch:' .github/workflows/kafka.yml || {
  echo 'Kafka workflow is not directly runnable for API builds' >&2
  exit 1
}

grep -Fq 'if: build.env("BENCHMARK") == "kafka"' .buildkite/pipeline.yml || {
  echo 'Buildkite Kafka workload is not manually gated' >&2
  exit 1
}

grep -Fq 'queue: hosted-m' .buildkite/pipeline.yml || {
  echo 'Kafka workflow is not assigned to the memory-sized hosted queue' >&2
  exit 1
}

grep -Fq 'github-actions#v0.9.3:' .buildkite/pipeline.yml || {
  echo 'GitHub Actions importer does not support configured runner profiles' >&2
  exit 1
}

grep -Fq 'version: "0.29.0"' .buildkite/pipeline.yml || {
  echo 'buildkite-gha runtime release is not pinned' >&2
  exit 1
}

grep -Fq 'gradle/actions/setup-gradle@d156388eb19639ec20ade50009f3d199ce1e2808' .github/workflows/kafka.yml || {
  echo 'Kafka Gradle cache setup is not pinned' >&2
  exit 1
}

grep -Fq './gradlew --build-cache build -x test' workloads/kafka || {
  echo 'Kafka measured command has drifted' >&2
  exit 1
}

for script in scripts/check scripts/fetch-source scripts/run-kafka workloads/*; do
  test -x "$script" || {
    echo "script is not executable: $script" >&2
    exit 1
  }
done

echo 'Static benchmark checks passed.'
